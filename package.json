{
  "name": "nodessh",
  "version": "1.0.0",
  "description": "A modern web-based MobaXterm alternative with SSH, SFTP, Tunneling, Key Management, and Multi-user SSO",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"wait-on http://localhost:5173 && wait-on dist/main/index.js && electron .\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "npm run build && electron .",
    "rebuild": "electron-rebuild",
    "test": "tsx src/main/server/test/backend.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.34.0",
    "mongodb": "^7.6.0",
    "multer": "^1.4.5-lts.1",
    "node-pty": "^1.1.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^11.1.0",
    "vite": "^8.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/ssh2": "^1.15.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.2",
    "electron": "^44.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wait-on": "^9.1.0"
  },
  "keywords": [
    "ssh",
    "sftp",
    "mobaxterm",
    "terminal",
    "xterm",
    "ssh-tunnel",
    "port-forwarding",
    "web-terminal",
    "electron"
  ],
  "author": "",
  "license": "MIT"
}
