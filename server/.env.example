# NodeSSH Server Environment Configuration Template

# Server Port and Host Binding (0.0.0.0 for LAN access, 127.0.0.1 for local only)
PORT=3001
HOST=0.0.0.0

# Secret Key used to sign user JWT session tokens
JWT_SECRET=change-me-to-a-secure-random-string-in-production

# Master AES-256-GCM Vault Key (32-byte string for key encrypt-at-rest)
VAULT_ENCRYPTION_KEY=nodessh-vault-master-key-32-byte

# Database Configuration (sqlite or mongodb)
DB_TYPE=sqlite
DB_PATH=data/nodessh.db

# MongoDB Configuration (only used if DB_TYPE=mongodb)
# MONGODB_URI=mongodb://127.0.0.1:27017/nodessh

# KBS Cloud SSO Authentication (Optional)
KBS_SSO_CLIENT_ID=nodessh
KBS_SSO_CLIENT_SECRET=
